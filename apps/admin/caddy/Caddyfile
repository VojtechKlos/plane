{
	servers {
		trusted_proxies static private_ranges
	}
}

:3000 {
	root * /usr/share/caddy/html

	# No rate limit: a page load fetches over a hundred files, offices share one
	# client IP, and the API behind the proxy applies its own throttles.
	encode zstd gzip

	# Security headers (HSTS is set at the TLS terminator)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}

	# Build output: file names carry a content hash, so a URL never changes
	handle /god-mode/assets/* {
		# Only on success, so a 404 for a not-yet-deployed file is not cached
		header {
			Cache-Control "public, max-age=31536000, immutable"
			match status 200
		}
		file_server
	}

	# SPA fallback: the admin build is served from /god-mode; revalidate it so a new release is picked up
	handle {
		header Cache-Control "no-cache"
		try_files {path} /god-mode/index.html
		file_server
	}

	# Access logs to stdout (default in Caddy)
	log {
		output stdout
		format console
	}
}
